{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "repository",
    "prompt",
    "oracle",
    "budgets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "tree": {
          "type": "string"
        }
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string"
    },
    "mutation": {
      "type": [
        "string",
        "null"
      ]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_source_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
