{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subject.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "adapter",
    "identity",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
